# The Centipede crew on one Qwen3.8-27B-FP8 server (deploy/README.md "The crew").
# Load it before any mugge command, from the mugge folder:  set -a; . deploy/crew.env; set +a
#
# One server, three entries in the machine list, so each kind of call has slots of its own:
#   b200-workers       10 slots  the 10 code agents (each ticket's write and fix calls)
#   b200-leads          2 slots  lead review of each ticket whose checks pass
#   b200-orchestrator   1 slot   the manager: architect, scaffold and ticket plan (mugge plan)
# 13 calls in flight at most; the server admits 32 (MAX_NUM_SEQS), so none waits in vLLM.
MUGGE_BACKENDS=@deploy/crew-b200.json
# tickets at once = code agents working
MUGGE_CONCURRENCY=10
# the served name, for anything that does not go through the machine list
MUGGE_MODEL=qwen3.8-27b
MUGGE_INFERENCE_URL=http://127.0.0.1:8000/v1
# planner calls are constrained to a JSON schema; vLLM takes the OpenAI response_format shape
MUGGE_GUIDED=response_format
# Qwen thinks on every call; the review call goes out with thinking off (MUGGE_REVIEW_THINKING).
MUGGE_THINKING=on
# most tokens one call may write; plus the largest pack it stays well under MAX_MODEL_LEN (65536)
MUGGE_MAX_CALL_TOKENS=16384
# No sampling variables: the engine sends Qwen's set per call from its thinking switch
# (thinking 1.0/0.95/20/0, off 0.7/0.8/20/0), and MUGGE_TEMPERATURE or MUGGE_TOP_P would
# override both. MUGGE_REASONING_EFFORT=medium thinks less and finishes sooner (default xhigh).
