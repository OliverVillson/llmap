# The Centipede crew on one Qwen3.8-27B server (deploy/README.md "The crew").
# Load it before any mugge command, from the mugge folder:  set -a; . deploy/crew.env; set +a
# The crew size is the one the server was started with (CREW_WORKERS=64 deploy/qwen.sh start);
# CREW_WORKERS in the environment overrides it.
#
# One server, three entries in the machine list (deploy/crew.py), so each kind of call has
# slots of its own:
#   b200-workers       CREW_WORKERS slots (default 10): the code agents' write and fix calls
#   b200-leads         one per 8 workers, at least 2: lead review of each passing ticket
#   b200-orchestrator  1 slot: the manager (architect, scaffold and ticket plan)
# the size the server was started for (deploy/qwen.sh start), else 10. Held in a scratch variable
# and unset below: under set -a a CREW_WORKERS assignment here would be exported, and would then
# override serve.crew for every later qwen.sh command and re-source in this shell.
_crew_n="${CREW_WORKERS:-$(cat "${STATE:-$HOME/qwen}/serve.crew" 2>/dev/null || echo 10)}"
# crew.py beside this file under bash (sourced from any folder), else relative to the mugge folder.
# POSIX only (no process substitution), so `. deploy/crew.env` works in sh/dash and zsh too.
_crew_py="${BASH_SOURCE:-deploy/crew.env}"; case "$_crew_py" in */*) _crew_py="${_crew_py%/*}/crew.py" ;; *) _crew_py=crew.py ;; esac
if [ ! -f "$_crew_py" ]; then echo "crew.env: $_crew_py not found; source it from the mugge folder" >&2; unset _crew_n _crew_py; return 1; fi
MUGGE_BACKENDS="$(python3 "$_crew_py" "$_crew_n")" || { echo "crew.env: crew.py failed for CREW_WORKERS=$_crew_n" >&2; unset _crew_n _crew_py; return 1; }
# tickets at once: 1.25 per worker slot (80 for 64), so a slot freed while an agent runs its
# checks or waits for review goes to another agent's call at once. Calls beyond the slots wait in
# the engine's pool, so this adds no GPU memory (the server admits workers + leads + 1).
MUGGE_CONCURRENCY="$(python3 "$_crew_py" "$_crew_n" --sizes | cut -d' ' -f5)"
unset _crew_n _crew_py
# the served name, for anything that does not go through the machine list
MUGGE_MODEL=qwen3.8-27b
MUGGE_INFERENCE_URL=http://127.0.0.1:8000/v1
# planner calls are constrained to a JSON schema; vLLM takes the OpenAI response_format shape
MUGGE_GUIDED=response_format
# Qwen thinks on every call, as much as each role's effort says: workers medium (they write
# most of the tokens; less thinking finishes tickets sooner), the orchestrator xhigh (few calls,
# where judgement matters), leads low: 8 lead slots review all 64 workers' tickets and every
# ticket waits for its review, so a long-thinking review queues the crew behind the leads (mock of
# the 64 crew: 141 s with lead=xhigh, up to 66 tickets waiting for a lead; 44 s with lead=low).
# A role set to off sends that role's calls without thinking; lead=off is the fallback if the
# view shows many tickets waiting for a lead.
MUGGE_THINKING=on
MUGGE_REASONING_EFFORT=worker=medium,lead=low,manager=xhigh
# most tokens one call may write; plus the largest pack it stays well under MAX_MODEL_LEN (65536)
MUGGE_MAX_CALL_TOKENS=16384
# No sampling variables: the engine sends Qwen's set per call from its thinking switch
# (thinking 1.0/0.95/20/0, off 0.7/0.8/20/0), and MUGGE_TEMPERATURE or MUGGE_TOP_P would
# override both.
