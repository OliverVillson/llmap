# The Centipede crew on one Mac's llama-server (deploy/MAC.md). Load it before any mugge command,
# from the mugge folder, in bash or zsh:  set -a; . deploy/mac.env; set +a
# The crew is the one the server was started for (deploy/mac.sh start saved it in ~/qwen-mac);
# before any start it is what deploy/mac_crew.py says this Mac fits.
#
# One server, three entries in the machine list, so each kind of call has slots of its own:
#   mac-workers       the code agents' write and fix calls (8 on a 16 GB Mac)
#   mac-leads         lead review of each passing ticket (one per 8 workers, at least 2)
#   mac-orchestrator  1 slot: the manager (architect, scaffold and ticket plan)
_mac_state="${STATE:-$HOME/qwen-mac}"
_mac_py="${BASH_SOURCE:-deploy/mac.env}"; case "$_mac_py" in */*) _mac_py="${_mac_py%/*}/mac_crew.py" ;; *) _mac_py=mac_crew.py ;; esac
if [ ! -f "$_mac_py" ]; then echo "mac.env: $_mac_py not found; source it from the mugge folder" >&2; unset _mac_state _mac_py; return 1; fi
if [ -f "$_mac_state/backends.json" ] && [ -f "$_mac_state/serve.plan.json" ]; then
  MUGGE_BACKENDS="$(cat "$_mac_state/backends.json")"
  _mac_plan="$(cat "$_mac_state/serve.plan.json")"
else
  echo "mac.env: no server started yet (deploy/mac.sh start); using the crew this Mac fits" >&2
  MUGGE_BACKENDS="$(python3 "$_mac_py" --backends --url "http://127.0.0.1:${PORT:-8080}/v1")" || { unset _mac_state _mac_py; return 1; }
  _mac_plan="$(python3 "$_mac_py" --json)"
fi
# tickets at once: 1.25 per worker slot; calls beyond the slots wait in the engine's pool
MUGGE_CONCURRENCY="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["agents"])' "$_mac_plan")"
MUGGE_MODEL="$(python3 -c 'import json, sys; print(json.loads(sys.argv[1])["served"])' "$_mac_plan")"
unset _mac_state _mac_py _mac_plan
MUGGE_INFERENCE_URL=http://127.0.0.1:${PORT:-8080}/v1
# planner and review answers are constrained to a JSON schema; llama-server applies it after the thinking
MUGGE_GUIDED=response_format
# Qwen3.5's chat template ignores reasoning_effort, so each level is a thinking budget instead:
# llama-server ends the thinking at that many tokens and the answer follows. Workers think a
# little (most tokens are theirs, and with the whole crew running a 16 GB Mac writes ~10 tokens a
# second per call), leads review without thinking, the orchestrator plans with more.
MUGGE_THINKING=on
MUGGE_REASONING_EFFORT=worker=low,lead=off,manager=medium
MUGGE_THINKING_BUDGET=low=1024,medium=4096,xhigh=8192
# most tokens one call writes: thinking budget plus a module and its tests; with a pack of up to
# ~10K it stays inside a slot's 16,384 tokens. Planning calls get more (the pool is empty then).
MUGGE_MAX_CALL_TOKENS=6144
MUGGE_PLAN_MAX_CALL_TOKENS=12288
# a Mac call is slow: an hour before one is given up on (the default is 30 minutes)
MUGGE_TIMEOUT_S=3600
